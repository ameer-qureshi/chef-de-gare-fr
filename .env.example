# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (see docs/adr/0001-llm-provider-switch.md) ---
# "ollama" = local open-weights model (sovereign mode)
# "mistral_api" = hosted Mistral API (fast development)
LLM_PROVIDER=ollama

# Local model via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Hosted model via Mistral API
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Timeouts and retries for every model call
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
